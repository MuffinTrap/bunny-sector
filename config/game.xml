<!--
This file configures game wide settings and map order and parameters

@game This is the root tag
	@name [default: "Bunny Sector"] Name of the game. Shown in main menu and window title

	Game must have at least one map
	@folder This is the folder where maps are loaded from
	@map This configures a map
		@file Filename of the wad that contains the map
		@name [optional] Name of the map
		@episode [default: 1] Episode number of this map
		@number [default: 1] Number of the map in the episode
		@gravity [default: 8024] How fast things accelerate downwards if they are in air
-->

<game>
	<name>Bunny Game</name>
	<folder>assets</folder>
	<map>
		<file>slade_test.wad</file>
	</map>

</game>
