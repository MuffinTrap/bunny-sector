<!--
This file configures game wide settings and map order and parameters

@game This is the root tag
	@name [default: "Bunny Sector"] Name of the game. Shown in main menu and window title
	@titlecolor [default: yellow] Color of the name of the game in main menu
	@mainbgcolor [default: blue] Color of the background in main menu
	@mainbgtexture [optional] Texture to show on the background of main menu

	Game must have at least one map
	@map This configures a map
		@file Filename of the wad that contains the map
		@number Number of the map, minimum is 1
		@name [optional] Name of the map
		@gravity [default: 8024] How fast things accelerate downwards if they are in air
		@fog [optional] This begins a section about fog in this map
			@density This is the density of fog from 1 to 100
			@color This is the color of the fog as hex value, eg 0xFF0000FF for red 
			@far The max distance visible in the fog, after this it is all fog
			@near The distance at which fog starts, befor this all is clear
		@skybox [optional] This begins a section about skybox colors in this map
			@zenith This is the hexademical color at the top of sky
			@horizon This is the hex color at the horizon line
			@nadir This is the hex color at the bottom of sky 
-->
<root>
	<game>
		<name>Hotel Everything</name>
		<titlecolor>0xfff8dcFF</titlecolor>
		<mainbgcolor>0x556b2fFF</mainbgcolor>

		<map>
			<file>assets/hotel_valju.wad</file>
			<number>1</number>
			<fog>
				<density>10</density>
				<near>10</near>
				<far>150</far>
				<color>0x556b2fFF</color>
			</fog>
			<skybox>
				<zenith>0x0000ffff</zenith>
				<horizon>0xccccccff</horizon>
				<nadir>0x111111ff</nadir>
			</skybox>
		</map>
	</game>
</root>
